{
  // wrangler.jsonc — Worker "guveloperational" (el nombre DEBE coincidir con el del Worker en Cloudflare).
  // PRIMER DEPLOY SIN DOMINIOS: solo publica en su dirección *.workers.dev y no toca operational.guvelsystems.com.
  // Los dominios de cada empresa (operational.<empresa>.guvelsystems.com) NO van aquí: los agrega la Edge Function create-company
  // como "Custom Domains" del Worker (igual que la app Quality). Para la empresa madre, cuando todo esté probado, descomenta "routes".
  "name": "guveloperational",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",            // la genera worker/build.mjs: index.html, css/, js/, assets/, config.js, _headers
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // "routes": [
  //   { "pattern": "operational.guvelsystems.com", "custom_domain": true }
  // ],
  "observability": { "enabled": true }
}
